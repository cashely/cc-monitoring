{
  "name": "cc-monitoring",
  "version": "0.1.3-alpha.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:proxy-admin": "pnpm -F proxy-admin dev",
    "build:proxy-admin": "pnpm -F proxy-admin build",
    "preview:proxy-admin": "pnpm -F proxy-admin preview",
    "dev:proxy-core": "pnpm -F @cc-monitoring/proxy-core dev",
    "build:proxy-core": "pnpm -F @cc-monitoring/proxy-core build",
    "dev:proxy-cli": "pnpm -F @cc-monitoring/proxy-cli dev",
    "build:proxy-cli": "pnpm -F @cc-monitoring/proxy-cli build",
    "preview:proxy-cli": "pnpm -F @cc-monitoring/proxy-cli preview",
    "dev:proxy-docs": "pnpm -F @cc-monitoring/docs dev",
    "build:proxy-docs": "pnpm -F @cc-monitoring/docs build",
    "preview:proxy-docs": "pnpm -F @cc-monitoring/docs preview",
    "build": "pnpm -F @cc-monitoring/proxy-core build && pnpm -F @cc-monitoring/proxy-cli build && pnpm -F proxy-admin build",
    "dev": "pnpm --filter @cc-monitoring/proxy-core dev",
    "dev:ui": "pnpm --filter @cc-monitoring/proxy-cli dev",
    "test": "pnpm -r test",
    "start": "node apps/proxy-core/dist/cli/index.js start",
    "stop": "node apps/proxy-core/dist/cli/index.js stop",
    "kill": "node apps/proxy-core/dist/cli/index.js kill",
    "status": "node apps/proxy-core/dist/cli/index.js status",
    "logs": "node apps/proxy-core/dist/cli/index.js logs",
    "config": "node apps/proxy-core/dist/cli/index.js config show",
    "reload": "node apps/proxy-core/dist/cli/index.js reload",
    "test-connection": "node apps/proxy-core/dist/cli/index.js test",
    "ui": "node apps/proxy-core/dist/cli/index.js ui",
    "cli": "node apps/proxy-core/dist/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
